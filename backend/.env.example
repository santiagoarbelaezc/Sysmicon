# ============================================================
# SYSMICON BACKEND — Plantilla de variables de entorno
# ============================================================
# Copia este archivo como `.env` y rellena los valores reales.
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sysmicon/proyectos

# --- App ---
APP_ENV=production
APP_URL=
FRONTEND_URL=

# --- CORS ---
ALLOWED_ORIGINS=
