# ============================================================
# Sysmicon Backend — Apache Configuration
# ============================================================

# Activar motor de reescritura
Options -Indexes
RewriteEngine On

# ---- CORS pre-flight (OPTIONS) ----
# Responder a OPTIONS sin pasar por PHP
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ index.php [QSA,L]

# Excepción para el endpoint /config (evitar que Apache lo trate como directorio físico)
RewriteRule ^config/?$ index.php [QSA,L]

# ---- Redirigir todo al router PHP si no es un archivo o directorio existente ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# ---- Seguridad: bloquear acceso directo a archivos y directorios sensibles ----
<FilesMatch "\.(env|json|lock|md|sql|log|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acceso directo a archivos dentro de carpetas sensibles
RewriteRule ^(vendor|node_modules|database|helpers|middleware|controllers)(/.*)?$ - [F,L]
RewriteRule ^config/.+$ - [F,L]

# ---- Caché para assets estáticos (si los hubiera) ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ---- Comprimir respuestas ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
</IfModule>
