{
  "name": "sysmicon/backend",
  "description": "Backend PHP API REST para Sysmicon",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^6.10",
    "cloudinary/cloudinary_php": "^2.13",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "files": [
      "helpers/Response.php",
      "helpers/Validator.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "audit": {
      "block": false
    }
  }
}
